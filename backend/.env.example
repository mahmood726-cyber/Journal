# Database Configuration
DATABASE_URL=postgresql://journal_user:journal_pass@localhost:5432/journal_db

# Security
SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourjournal.com
SMTP_FROM_NAME=Your Journal Name

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
ALLOWED_MANUSCRIPT_FORMATS=pdf,doc,docx,tex,zip

# DOI Configuration (Crossref)
DOI_PREFIX=10.xxxxx
DOI_USERNAME=your-crossref-username
DOI_PASSWORD=your-crossref-password
DOI_API_URL=https://api.crossref.org
DOI_TEST_MODE=true

# Alternative: DataCite
# DOI_PROVIDER=datacite
# DATACITE_REPOSITORY_ID=your-repo-id
# DATACITE_PASSWORD=your-password

# PubMed Central Configuration
PMC_FTP_HOST=ftp.ncbi.nlm.nih.gov
PMC_FTP_USER=your-pmc-username
PMC_FTP_PASSWORD=your-pmc-password
PMC_FTP_PATH=/upload

# Journal Metadata
JOURNAL_TITLE=Your Journal Name
JOURNAL_SHORT_TITLE=YJN
JOURNAL_ISSN=1234-5678
JOURNAL_EISSN=8765-4321
JOURNAL_PUBLISHER=Your Publisher Name
JOURNAL_URL=https://journal.yoursite.com
JOURNAL_EMAIL=editor@yourjournal.com

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Application
API_V1_PREFIX=/api/v1
PROJECT_NAME=Diamond OA Journal
DEBUG=true

# ORCID Integration
ORCID_CLIENT_ID=your-orcid-client-id
ORCID_CLIENT_SECRET=your-orcid-client-secret
ORCID_API_URL=https://pub.orcid.org/v3.0

# Storage (local or S3)
STORAGE_TYPE=local  # or s3
# For S3:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_BUCKET_NAME=your-bucket
# AWS_REGION=us-east-1
